# Qloo hackathon key (request it from the Qloo hackathon developer guide).
QLOO_API_KEY=
# Hackathon keys only work here; production keys can use https://api.qloo.com
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Anthropic key for the Claude agent. Without it the app runs Autopilot.
ANTHROPIC_API_KEY=
# Or a free Groq key (console.groq.com) to run the same agent on an open model.
# Used only when ANTHROPIC_API_KEY is empty.
GROQ_API_KEY=
# Optional: GROQ_MODEL (default openai/gpt-oss-120b), GROQ_FALLBACK_MODEL for oversized requests.
GROQ_MODEL=
# Set to 1 to force Autopilot even when an LLM key is set.
FANROUTE_AUTOPILOT=
# PayPal sandbox app (developer.paypal.com > Apps & Credentials). Without these,
# fan pledges run in a clearly labelled demo mode and no money moves.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to the sandbox; set https://api-m.paypal.com only for live payments.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Pledge storage on serverless hosts: a private Vercel Blob store (BLOB_READ_WRITE_TOKEN, set automatically
# when the store is connected to the project) or Upstash Redis REST. Locally a JSON file in the OS temp dir is used.
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
